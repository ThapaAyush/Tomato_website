# Environment variables for Backend deployment (Render, local, etc.)

# Port is automatically assigned by Render, but can be set locally
PORT=4000

# Node Environment
NODE_ENV=production

# MongoDB Atlas connection string (ensure Network Access in Atlas allows 0.0.0.0/0)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT secret key for auth token signing
JWT_SECRET=your_super_secret_jwt_key_here

# Razorpay credentials (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Optional: Comma-separated list of allowed origins for CORS (leave empty or * to allow all)
# Example: https://food-del.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Email Notifications (e.g. Gmail App Password or custom SMTP)
# To send live sign-in and welcome emails, set your Gmail and App Password:
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-16-char-app-password
EMAIL_FROM="Tomato Food Delivery" <noreply@tomato.com>
# Or Custom SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

